#!/bin/sh
# warden-k9s: the k9s side of Warden (Homelab ADR 0011 amendment 2026-11-25).
#
# Warden is a read-only server; this is a client. It opens Warden's console in
# the browser or asks Warden to investigate, and never touches Kubernetes
# itself: whatever you do next in k9s runs with your own kubeconfig.
#
#   warden-k9s open ns <namespace>             console: what changed, traffic, blast radius
#   warden-k9s open inv <id>                   console: one investigation
#   warden-k9s investigate <namespace> [pod]   run the collectors now, open the result
#   warden-k9s investigate-node <node>
#   warden-k9s whoami                          check the credentials
#
# Environment:
#   WARDEN_URL          default https://warden.lab.home
#   WARDEN_CREDENTIALS  file holding "<authentik user>:<app password>"
#                       (default ~/.config/warden/credentials, keep it mode 600).
#                       Only investigate/whoami need it; "open" uses the
#                       browser's own authentik session.
#   WARDEN_CACERT       CA bundle for *.lab.home if the Homelab Root CA is not
#                       in the system trust store
#   WARDEN_NO_BROWSER   set to print URLs instead of opening them
set -eu

url=${WARDEN_URL:-https://warden.lab.home}
url=${url%/}
creds=${WARDEN_CREDENTIALS:-${XDG_CONFIG_HOME:-$HOME/.config}/warden/credentials}

die() { echo "warden-k9s: $*" >&2; exit 1; }

# Kubernetes names only: they end up in a URL and a JSON body.
name() {
	printf '%s' "$1" | grep -Eq '^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$' ||
		die "\"$1\" is not a Kubernetes name"
}

browse() {
	echo "$1"
	[ -n "${WARDEN_NO_BROWSER:-}" ] && return 0
	for b in xdg-open open wslview; do
		if command -v "$b" >/dev/null 2>&1; then "$b" "$1" >/dev/null 2>&1 & return 0; fi
	done
	if command -v cmd.exe >/dev/null 2>&1; then cmd.exe /c start "" "$1" >/dev/null 2>&1; return 0; fi
	echo "(no browser opener found; open the URL above)" >&2
}

# api METHOD PATH [JSON]: the credential goes to curl on stdin (-K -), so it
# never shows up in the process list.
api() {
	[ -r "$creds" ] || die "no credentials at $creds (\"<user>:<app password>\", see contrib/k9s/README.md)"
	cred=$(head -n 1 "$creds" | tr -d '\r\n')
	case $cred in *:?*) ;; *) die "$creds must hold \"<user>:<app password>\"" ;; esac
	set -- "$@" ""
	cred=$(printf '%s' "$cred" | sed 's/\\/\\\\/g; s/"/\\"/g')
	printf 'user = "%s"\n' "$cred" |
		curl -sS --fail-with-body --max-time 120 -K - ${WARDEN_CACERT:+--cacert "$WARDEN_CACERT"} \
			-X "$1" -H 'Content-Type: application/json' -H 'X-Warden-Request: 1' \
			${3:+--data "$3"} "$url$2"
}

investigate() {
	echo "Warden: investigating $2 (journal only, no push; the collectors can take a minute)..."
	out=$(api POST /console/api/investigate "$1") || die "investigate failed: $out"
	id=$(printf '%s' "$out" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
	[ -n "$id" ] || die "unexpected answer: $out"
	browse "$url/console#/inv/$id"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
open)
	[ $# -eq 2 ] || die "usage: warden-k9s open ns|inv <name>"
	case $1 in
	ns) name "$2"; browse "$url/console#/ns/$2" ;;
	inv) printf '%s' "$2" | grep -Eq '^[A-Za-z0-9_-]+$' || die "bad investigation id"
		browse "$url/console#/inv/$2" ;;
	*) die "usage: warden-k9s open ns|inv <name>" ;;
	esac ;;
investigate)
	[ $# -ge 1 ] && [ $# -le 2 ] || die "usage: warden-k9s investigate <namespace> [pod]"
	name "$1"
	if [ $# -eq 2 ] && [ -n "$2" ]; then
		name "$2"; investigate "{\"namespace\":\"$1\",\"pod\":\"$2\"}" "pod $1/$2"
	else
		investigate "{\"namespace\":\"$1\"}" "namespace $1"
	fi ;;
investigate-node)
	[ $# -eq 1 ] || die "usage: warden-k9s investigate-node <node>"
	name "$1"; investigate "{\"node\":\"$1\"}" "node $1" ;;
whoami)
	api GET /console/api/whoami; echo ;;
*)
	sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; [ -z "$cmd" ] || exit 2 ;;
esac
